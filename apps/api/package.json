{
  "name": "@aikayun/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset:test": "tsx src/db/reset-test-database.ts",
    "admin:init": "tsx src/admin-init.ts",
    "identity:init": "tsx src/licensing/installation-identity-cli.ts init",
    "identity:verify": "tsx src/licensing/installation-identity-cli.ts verify",
    "license-pending-key:init": "tsx src/licensing/pending-encryption-key-cli.ts init",
    "license-pending:restore-check": "tsx src/licensing/license-pending-restore-check.ts",
    "media:check": "tsx src/media/reconcile-cli.ts --check",
    "private-files:check": "tsx src/media/private-file-reconcile-cli.ts --check",
    "private-files:repair": "tsx src/media/private-file-reconcile-cli.ts --repair",
    "purchase-drafts:check": "tsx src/media/purchase-draft-reconcile-cli.ts --check",
    "purchase-drafts:repair": "tsx src/media/purchase-draft-reconcile-cli.ts --repair",
    "purchase-order-attachments:check": "tsx src/media/purchase-order-attachment-reconcile-cli.ts --check",
    "purchase-order-attachments:repair": "tsx src/media/purchase-order-attachment-reconcile-cli.ts --repair"
  },
  "dependencies": {
    "@aikayun/contracts": "workspace:*",
    "@aikayun/money": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/type-provider-typebox": "6.3.0",
    "@misskey-dev/node-http-message-signatures": "1.1.2",
    "canonicalize": "5.1.0",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "jsonc-parser": "3.3.1",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "structured-headers": "1.0.1",
    "typebox": "1.3.37"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "4.1.11"
  }
}
