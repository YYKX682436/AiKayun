{
  "name": "@aikayun/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset:test": "tsx src/db/reset-test-database.ts",
    "admin:init": "tsx src/admin-init.ts"
  },
  "dependencies": {
    "@aikayun/contracts": "workspace:*",
    "@aikayun/money": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/type-provider-typebox": "6.3.0",
    "fastify": "5.12.7",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "typebox": "1.3.37"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "4.1.11"
  }
}
