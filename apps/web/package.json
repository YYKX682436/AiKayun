{
  "name": "@aikayun/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json && vue-tsc --noEmit -p .nuxt/tsconfig.server.json",
    "test:e2e": "playwright test && playwright test --config playwright.brand-alt.config.ts",
    "test:e2e:production-brand": "playwright test --config playwright.production-brand.config.ts"
  },
  "dependencies": {
    "@aikayun/contracts": "workspace:*",
    "@nuxt/ui": "4.11.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-bullet-list": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-horizontal-rule": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list-item": "3.32.0",
    "@tiptap/extension-ordered-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "culori": "4.0.2",
    "nuxt": "4.6.1",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.145",
    "@playwright/test": "1.64.1",
    "@types/culori": "4.0.1",
    "vue-tsc": "3.3.13"
  }
}
