# Generate a unique password and set it before starting Compose.
POSTGRES_USER=aikayun
POSTGRES_PASSWORD=
POSTGRES_DB=aikayun

# Persistent container directory for public product images.
MEDIA_ROOT=/var/lib/aikayun/media

# Separate persistent namespace for non-public digital-goods files.
PRIVATE_FILE_ROOT=/var/lib/aikayun/private-files

# Browser origin used for administrator CSRF checks.
PUBLIC_ORIGIN=http://localhost:8080
# Canonical and Open Graph origin rendered by the public storefront.
NUXT_PUBLIC_SITE_URL=http://localhost:8080
COOKIE_SECURE=false
TRUST_PROXY=true

# API-only AES-256-GCM key ring for encrypted payment credentials.
# Generate a 32-byte key with `openssl rand -base64 32` and keep it out of Git.
# PAYMENT_CREDENTIAL_KEY_RING={"activeKeyId":"v1","keys":{"v1":"BASE64_OF_32_RANDOM_BYTES"}}

# Separate API-only key ring for encrypted digital codes. Keep historical keys
# available to every API instance while rows still reference those key IDs.
# CODE_POOL_ENCRYPTION_KEY_RING={"activeKeyId":"v1","keys":{"v1":"BASE64_OF_32_RANDOM_BYTES"}}

# Local host bindings. For public deployment, set HTTP_BIND_ADDRESS=0.0.0.0,
# use ports 80 and 443, SITE_ADDRESS=your domain, HTTPS origin, and COOKIE_SECURE=true.
PG_PORT=5432
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80

# Public storefront identity. Supported logo URLs are root-relative or HTTPS.
NUXT_PUBLIC_STORE_NAME="AiKayun 数字商城"
NUXT_PUBLIC_STORE_LOGO_URL=
NUXT_PUBLIC_STORE_BRAND_COLOR=#2563EB
