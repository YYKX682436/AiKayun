# Generate a unique password and set it before starting Compose.
POSTGRES_USER=aikayun
POSTGRES_PASSWORD=
POSTGRES_DB=aikayun

# Browser origin used for administrator CSRF checks.
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
TRUST_PROXY=true

# Local host bindings. For public deployment, set HTTP_BIND_ADDRESS=0.0.0.0,
# use ports 80 and 443, SITE_ADDRESS=your domain, HTTPS origin, and COOKIE_SECURE=true.
PG_PORT=5432
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80

# Public storefront identity. Supported logo URLs are root-relative or HTTPS.
NUXT_PUBLIC_STORE_NAME="AiKayun 数字商城"
NUXT_PUBLIC_STORE_LOGO_URL=
NUXT_PUBLIC_STORE_BRAND_COLOR=#2563EB
