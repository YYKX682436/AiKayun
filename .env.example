# Generate a unique password and set it before starting Compose.
POSTGRES_USER=aikayun
POSTGRES_PASSWORD=
POSTGRES_DB=aikayun

# Browser origin used for administrator CSRF checks.
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
TRUST_PROXY=true

# Local host bindings. For a public deployment, use 80 and 443 and set SITE_ADDRESS to your domain.
PG_PORT=5432
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80
